NEXT_PUBLIC_SITE_URL=https://kiteaviation.in
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-admin-password.js 'your-password'
# Escape $ as \$ so Next/dotenv does not expand the bcrypt hash
ADMIN_PASSWORD_HASH=\$2b\$10\$replace_with_generated_hash
SESSION_SECRET=replace_with_long_random_string
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=
TELECRM_API_URL=
TELECRM_API_KEY=
